---
import Layout from "@/layouts/Layout.astro";
import ClubStructure from "@/components/ClubStructureComponent.tsx";
import PageHero from "@/components/PageHero";
import currentBoardSource from "@/content/structures/2026-2027.yaml?raw";
import {
  getCmsStructures,
  type CmsBoardMember,
  type CmsEntry,
  type CmsStructure,
} from "@/lib/emdash-content";

const cmsStructures = await getCmsStructures();
const currentBoardMembers = JSON.parse(
  currentBoardSource
    .replace(/^members:\s*>-\s*/, "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .join(" "),
) as CmsBoardMember[];
const currentBoard = {
  id: "2026-2027",
  slug: "2026-2027",
  data: { members: currentBoardMembers },
} satisfies CmsEntry<CmsStructure>;

// Keep the checked-in current board authoritative so a deployment does not
// depend on a separate remote CMS import. Older boards continue to come from CMS.
const structures = Array.from(
  new Map([...cmsStructures, currentBoard].map((entry) => [entry.id, entry])).values(),
).sort((a, b) => b.id.localeCompare(a.id));
---

<Layout
  title="Rotaract Structure"
  description="Learn more about our club's structure and organization."
>
  <main class="flex-1">
    <PageHero
      title="Club Structure"
      description="Here are the board members and directors who lead our club's initiatives."
      client:load
    />
    <section class="w-full">
      <div class="container px-4 md:px-6">
        {
          structures.length > 0 ? (
            <ClubStructure structures={structures} client:load />
          ) : (
            <div class="flex items-center justify-center h-96">
              <p class="text-lg text-gray-500 dark:text-gray-400">
                No club structure information available right now.
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>
